# Cloned reference repos (not tracked)
POP/
subgraph-pop/

# Dependencies belong to the application workspace, not the repository root.
/node_modules/

# Playwright MCP artifacts (snapshots, console logs, recordings)
.playwright-mcp/
/*.gif
/poa-app/*.gif

# Verification artifacts (screenshots, gifs, logs, ids, fingerprints)
.context/

# Smithers CLI can drop a SQLite db at the repo root — never commit it
/smithers.db
/smithers.db-shm
/smithers.db-wal

# Claude Code session state (per-workspace, not for source control)
.claude/
