{
  "name": "poa-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "next dev --webpack",
    "dev:e2e": "NEXT_PUBLIC_E2E_MODE=true next dev --webpack",
    "dev:e2e-passkey": "NEXT_PUBLIC_E2E_MODE=true NEXT_PUBLIC_E2E_AS=passkey next dev --webpack",
    "build": "node scripts/generate-sitemap.mjs && next build --webpack",
    "generate-sitemap": "node scripts/generate-sitemap.mjs",
    "lint": "eslint .",
    "e2e:setup": "node scripts/e2e/setup-machine.js",
    "e2e:check": "node scripts/e2e/check-prod-leakage.js",
    "e2e:test-passkey": "node scripts/e2e/test-virtual-passkey.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live-subgraph": "POA_LIVE_SUBGRAPH_TESTS=1 vitest run src/util/queriesAccessV2.live.test.js",
    "test:live-chain": "POA_LIVE_CHAIN_TESTS=1 vitest run src/config/contractLimits.live.test.js"
  },
